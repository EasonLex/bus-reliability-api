# 複製成同一個資料夾底下的 .env.api，填好密碼：
#     cp env.api.example .env.api && vi .env.api
#
# 放在這個 repo 裡面（不是主專案根目錄），因為這裡的 .gitignore
# 已經蓋掉 .env.*，不必再去別的 repo 補一行。
#
# 還是驗證一次，不要相信「應該有蓋到」：
#     git check-ignore -v .env.api      ← 要有輸出

# 服務名，不是 IP。api 跟 mysql 在同一個 docker network 上。
MYSQL_HOST=mysql
MYSQL_PORT=3306

# 只有 SELECT 的帳號，見 sql/grant_readonly.sql
MYSQL_USER=bus_api
MYSQL_PASSWORD=<跟 grant_readonly.sql 裡設的同一組>
MYSQL_DATABASE=bus

# 每個 uvicorn worker 各自持有這麼多條連線。
# 2 workers × 5 = 10，離 MySQL 的 --max-connections=32 還很遠。
DB_POOL_SIZE=5
